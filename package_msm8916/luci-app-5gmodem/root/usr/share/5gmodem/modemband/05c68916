# Qualcomm MSM8916 Snapdragon 410 SoC Modem
_BAND_VIA=mmcli
_MMIDX=$(/usr/share/5gmodem/modemswitch.sh mmindex 2>/dev/null); [ -n "$_MMIDX" ] || _MMIDX=any

# LTE Bands supported by Snapdragon 410 modem
_DEFAULT_LTE_BANDS="1 2 3 5 7 8 20 40"
_DEFAULT_3G_BANDS="1 2 5 8"
_DEFAULT_2G_BANDS="egsm dcs pcs g850"

getinfo() {
	echo "Qualcomm Snapdragon MSM8916"
}

getsupportedmodes() {
	echo "2g 3g 4g 2g|3g 3g|4g 2g|3g|4g"
}

getmode() {
	mmcli -m "$_MMIDX" 2>/dev/null | grep "current:" | head -1 | sed -e 's/.*allowed:[ \t]*//' -e 's/;.*//' | tr -d ' '
}

setmode() {
	MODE="$1"
	case "$MODE" in
		"4g") mmcli -m "$_MMIDX" --set-allowed-modes="4g" --set-preferred-mode="4g" ;;
		"3g") mmcli -m "$_MMIDX" --set-allowed-modes="3g" --set-preferred-mode="3g" ;;
		"2g") mmcli -m "$_MMIDX" --set-allowed-modes="2g" --set-preferred-mode="2g" ;;
		"3g|4g") mmcli -m "$_MMIDX" --set-allowed-modes="3g,4g" --set-preferred-mode="4g" ;;
		"2g|3g") mmcli -m "$_MMIDX" --set-allowed-modes="2g,3g" --set-preferred-mode="3g" ;;
		"2g|3g|4g"|"auto"|*) mmcli -m "$_MMIDX" --set-allowed-modes="2g,3g,4g" --set-preferred-mode="4g" ;;
	esac
}

_mm_current_bands() {
	mmcli -m "$_MMIDX" 2>/dev/null | sed -n 's/.*current:[ \t]*//p' | tr ',' ' '
}

_mm_other_bands() {
	prefix="$1"
	for B in $(_mm_current_bands); do
		case "$B" in
			${prefix}*) ;;
			*) echo "$B";;
		esac
	done
}

_mm_join_pipe() {
	res=""
	for x in "$@"; do
		[ -n "$x" ] && res="${res}${res:+|}$x"
	done
	printf '%s' "$res"
}

getsupportedbands() {
	echo "$_DEFAULT_LTE_BANDS"
}

getbands() {
	for B in $(_mm_current_bands); do
		case "$B" in
			eutran-*) echo "${B#eutran-}";;
		esac
	done | xargs
}

setbands() {
	BANDS="$1"
	if [ "$BANDS" = "default" ] || [ -z "$BANDS" ]; then
		mmcli -m "$_MMIDX" "--set-current-bands=eutran-1|eutran-3|eutran-8|utran-1|utran-8|egsm|dcs"
		return 0
	fi

	NEW_EUTRAN=""
	for BAND in $BANDS; do
		case $BAND in
			''|*[!0-9]*) continue ;;
		esac
		NEW_EUTRAN="${NEW_EUTRAN}${NEW_EUTRAN:+|}eutran-${BAND}"
	done
	[ -z "$NEW_EUTRAN" ] && return 1

	OTHER=$(_mm_other_bands "eutran-")
	[ -z "$OTHER" ] && OTHER="utran-1 utran-8 egsm dcs"
	FULL=$(_mm_join_pipe $OTHER)
	FULL="${FULL}${FULL:+|}${NEW_EUTRAN}"

	mmcli -m "$_MMIDX" "--set-current-bands=$FULL"
}
