CONFIG_DEVEL=y
# Target Board Architecture
CONFIG_TARGET_msm89xx=y
CONFIG_TARGET_msm89xx_msm8916=y
CONFIG_TARGET_msm89xx_msm8916_DEVICE_jz01-45-v33=y
CONFIG_TARGET_BOARD="msm89xx"
CONFIG_TARGET_SUBTARGET="msm8916"
CONFIG_TARGET_PROFILE="DEVICE_jz01-45-v33"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_generic"
# CONFIG_TARGET_mediatek is not set
CONFIG_USE_APK=y
CONFIG_PACKAGE_apk-mbedtls=y

# Crypto & SSL Defaults (Standardize on mbedtls / openssl to prevent wolfssl hash mismatch)
CONFIG_PACKAGE_libmbedtls=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_libwolfssl is not set

# 1. Modem & Cellular Protocol Stack
CONFIG_PACKAGE_modemmanager=y
CONFIG_PACKAGE_qmi-utils=y
CONFIG_PACKAGE_libqmi=y
CONFIG_PACKAGE_libmbim=y
CONFIG_PACKAGE_mbim-utils=y
CONFIG_PACKAGE_sms-tool=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_coreutils-stty=y
CONFIG_PACKAGE_luci-app-5gmodem=y
CONFIG_PACKAGE_libqrtr-glib=y
CONFIG_PACKAGE_luci-proto-modemmanager=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-mbim=y
CONFIG_PACKAGE_luci-proto-ppp=y

# 2. Kernel LED Trigger Modules
CONFIG_PACKAGE_kmod-ledtrig-netdev=y
CONFIG_PACKAGE_kmod-ledtrig-timer=y
CONFIG_PACKAGE_kmod-ledtrig-heartbeat=y
CONFIG_PACKAGE_kmod-ledtrig-activity=y
CONFIG_PACKAGE_kmod-ledtrig-oneshot=y
CONFIG_PACKAGE_kmod-leds-gpio=y

# 3. USB Networking & Ethernet Gadget (RNDIS / CDC-Ether / NCM)
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-gadget-eth=y
CONFIG_PACKAGE_luci-app-usb-gadget=y

# 4. WiFi Subsystem (Qualcomm WCN3660)
CONFIG_PACKAGE_kmod-wcn36xx=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_iwinfo=y

# 5. LuCI Web Interface & Tools
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-proton2025=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y

# 6. Storage & System Utilities
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_fdisk=y
